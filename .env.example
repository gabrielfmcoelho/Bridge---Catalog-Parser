# catalog-parser — copy to .env (never commit .env: it holds a token).
# Only CATALOG_PARSER_* keys are read; variables already exported in the shell win over this file.
# The .env is searched from the linted repository (catalog-lint: the working directory) up to its .git.

# Config location: a path, or a URL such as a GitLab file page (/-/blob/<ref>/<path>).
CATALOG_PARSER_CONFIG=https://gitlab.example.org/platform/catalog-governance/-/blob/main/.catalog-parser.toml

# Token for a private config URL: GitLab personal access token with the read_api scope
# (sent as PRIVATE-TOKEN); other hosts get "Authorization: Bearer <token>".
CATALOG_PARSER_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
