# catalog-parser — copy to .env (never commit .env: it holds a token).
# Only CATALOG_PARSER_* keys are read; variables already exported in the shell win over this file.
# The .env is searched from the linted repository (catalog-lint: the working directory) up to its .git.

# Config location: a path, or a URL (GitLab, GitHub, Bitbucket, or raw HTTPS).
# Alternatively, commit `extends = "https://..."` in your local .catalog-parser.toml and keep only the token here.
CATALOG_PARSER_CONFIG=https://gitlab.example.org/platform/catalog-governance/-/blob/main/.catalog-parser.toml

# Token for a private config or peer URL:
# - GitLab personal/project access token with `read_api` scope (sent as PRIVATE-TOKEN)
# - GitHub / Bitbucket / generic HTTPS token (sent as "Authorization: Bearer <token>")
CATALOG_PARSER_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional: custom HTTP authentication header name (overrides PRIVATE-TOKEN / Authorization)
# CATALOG_PARSER_AUTH_HEADER=X-API-Key

# Optional: local cache TTL in seconds for remote configs and remote peers (default: 0 = disabled)
# CATALOG_PARSER_CACHE_TTL=300
# CATALOG_PARSER_CACHE_DIR=/tmp/catalog-parser-cache
